# Copy to apps/web/.env.local and fill in. Never commit .env.local (it is gitignored).

NEXT_PUBLIC_API_BASE_URL=

# Practice Session: Maya, the AI mentor (PS7_BUILD_BRIEF.md section 16).
# With no AI configured, Maya still answers, from saved tips.
# Server-side only: never prefix these with NEXT_PUBLIC_.

# gemini (default) or ollama
AI_PROVIDER=gemini
# Key from Google AI Studio ("Get API key").
GEMINI_API_KEY=
# Leave empty for gemini-flash-latest.
GEMINI_MODEL=
# Give up on the AI after this many ms and use a saved tip instead. Raise it for a local model on CPU.
AI_TIMEOUT_MS=10000

# Local model, used when AI_PROVIDER=ollama. Install Ollama, then `ollama pull <model>`.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# Email composer: suggested messages and casual-word flags (app/api/email-assist).
# Without a key the composer still works and still flags common casual words like "bhaiya" or "pls".
# Key from build.nvidia.com ("Get API Key"). Server-side only: never prefix with NEXT_PUBLIC_.
NVIDIA_API_KEY=
# Leave empty for nvidia/nemotron-3.5-lightning-30b-a3b. Many listed models return 404 for a free
# key, so try one with a real call first.
NVIDIA_MODEL=
# Give up on a suggestion after this many ms.
NVIDIA_TIMEOUT_MS=8000

# Lounge TV search (app/api/tv-search). Without a key the TV still plays pasted links.
# Google Cloud Console: enable "YouTube Data API v3", then Credentials > Create API key (restrict it
# to that API). Free quota: about 100 searches a day; repeat searches are cached.
# Server-side only: never prefix with NEXT_PUBLIC_.
YOUTUBE_API_KEY=
