# Copy to apps/server/.env and fill in. Never commit the real .env (it is gitignored).

DATABASE_URL=postgresql://user:password@localhost:5432/clario
JWT_SECRET=change-me
REDIS_URL=redis://localhost:6379
PORT=3001
# Comma-separated list of allowed browser origins (localhost is always allowed).
CORS_ORIGIN=http://localhost:3000

# Email composer (POST /api/v1/space/:spaceId/email). Set up SMTP or Resend; SMTP wins if both are set.
# With neither, the endpoint answers 503 "Email is not configured on this server yet."

# Option 1: SMTP (Gmail, Outlook, Brevo, Mailgun or any other mail server).
# Gmail: turn on 2-Step Verification, create an App Password at
# https://myaccount.google.com/apppasswords and paste its 16 letters without the spaces.
# Your normal Gmail password will not work. Example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587.
SMTP_HOST=
# 587 upgrades to TLS with STARTTLS; 465 uses TLS from the start. Defaults to 587; prefer it.
# Under Bun 1.3, port 465 fails with "Cert does not contain a DNS name" on networks where the
# mail server has an IPv6 address but this machine has no IPv6 route.
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: true or false, to override the TLS mode picked from the port.
SMTP_SECURE=

# Option 2: Resend's HTTP API. API key from https://resend.com/api-keys
RESEND_API_KEY=

# Sender shown to recipients. Required for Resend. With SMTP it defaults to "Clario <SMTP_USER>",
# which is what Gmail needs anyway: it rewrites any other From to the account you log in with.
# Resend's test sender, Clario <onboarding@resend.dev>, only delivers to your own Resend account's
# address; to reach anyone else, verify a domain in Resend and use an address on it.
EMAIL_FROM=
